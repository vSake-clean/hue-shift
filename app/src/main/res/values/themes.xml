<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.HueShift" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/hs_background</item>
        <item name="android:colorAccent">@color/hs_violet</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Used by the launcher shortcut: no window, no animation. -->
    <style name="Theme.HueShift.Invisible" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowNoDisplay">false</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
