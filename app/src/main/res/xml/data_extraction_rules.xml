<?xml version="1.0" encoding="utf-8"?>
<!-- Only the hue-shift settings are worth backing up. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/hue_settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/hue_settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
